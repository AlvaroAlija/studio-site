---
import { stats } from "../lib/content";
---

<section id="about">
  <div class="cols">
    <div>
      <p class="eyebrow">05 — About</p>
      <h2 class="section-h2">One person, two crafts.</h2>
      <p class="prose">
        I model, light and render in Blender, then take the same worlds into
        Godot and make them playable. The renders pay for the games; the games
        give the renders a reason to exist.
      </p>
      <p class="prose last">
        Available for freelance environment art, product renders and small game
        contracts.
      </p>
    </div>
    <div class="stats">
      {stats.map((s) => (
        <div class="stat">
          <p class="value">{s.value}</p>
          <p class="label">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 72px var(--gutter);
    max-width: 1440px;
    margin: 0 auto;
    border-top: 1px solid var(--border-subtle);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }

  .section-h2 {
    margin-bottom: 22px;
  }

  .prose {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 56ch;
    text-wrap: pretty;
  }

  .prose.last {
    margin-bottom: 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }

  .stat {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    background: var(--surface);
  }

  .value {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .label {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
